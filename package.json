{
  "name": "ai-sales-saas",
  "version": "3.2.0",
  "private": true,
  "description": "AI销售管理系统 V3.2 — 客户/项目持续跟进能力",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "typecheck": "turbo run typecheck",
    "db:migrate": "pnpm --filter @ai-sales/api db:migrate",
    "db:generate": "pnpm --filter @ai-sales/api db:generate",
    "db:studio": "pnpm --filter @ai-sales/api db:studio",
    "db:seed": "pnpm --filter @ai-sales/api db:seed"
  },
  "devDependencies": {
    "turbo": "^2.4.0"
  },
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.0.0"
  }
}

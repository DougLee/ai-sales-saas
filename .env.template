# =============================================================================
# AI 销售管理系统 — 生产环境变量模板
# 复制本文件为 .env 后填入实际值，严禁将真实密钥提交到版本控制
# =============================================================================

# -----------------------------------------------------------------------------
# 核心运行时（必填）
# -----------------------------------------------------------------------------

# 数据库：使用容器内服务名或外部托管数据库
DATABASE_URL="postgresql://ai_sales:YOUR_DB_PASSWORD@postgres:5432/ai_sales_prod?schema=public"

# Redis：用于 session、限流计数器、agent 记忆
REDIS_URL="redis://redis:6379"

# JWT 密钥：生产环境必须生成强随机字符串，至少 64 位
JWT_SECRET=""

# Node 环境
NODE_ENV="production"
PORT=3000

# -----------------------------------------------------------------------------
# 可观测性（可选，有默认值）
# -----------------------------------------------------------------------------
LOG_LEVEL="info"              # trace / debug / info / warn / error / fatal
SERVICE_NAME="ai-sales-api"
# SERVICE_VERSION=""          # 默认从 package.json 读取

# -----------------------------------------------------------------------------
# AI 大模型（必填，AI 功能依赖）
# -----------------------------------------------------------------------------
# 支持 OpenAI 官方或任意 OpenAI 兼容接口
OPENAI_API_KEY=""
OPENAI_BASE_URL=""           # 例如 https://api.siliconflow.cn/v1

# Embedding 可单独配置；默认复用上方凭证
# EMBEDDING_API_KEY=""
# EMBEDDING_BASE_URL=""
EMBEDDING_MODEL_NAME="BAAI/bge-m3"
EMBEDDING_DIMENSION=1024

# 语音转写（SenseVoice，可选）
# SENSEVOICE_API_KEY=""
# SENSEVOICE_BASE_URL=""

# -----------------------------------------------------------------------------
# 限流（可选，有默认值）
# -----------------------------------------------------------------------------
RATE_LIMIT_DEFAULT_MAX=200
RATE_LIMIT_DEFAULT_WINDOW_MS=60000
RATE_LIMIT_AGENT_MAX=20
RATE_LIMIT_AGENT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# 对象存储（必填，文件上传依赖）
# -----------------------------------------------------------------------------
MINIO_ENDPOINT="http://minio:9000"
MINIO_ACCESS_KEY=""
MINIO_SECRET_KEY=""

# -----------------------------------------------------------------------------
# 搜索增强（可选）
# -----------------------------------------------------------------------------
# BING_SEARCH_API_KEY=""
# TAVILY_API_KEY=""

# -----------------------------------------------------------------------------
# Docker Compose 生产部署（可选）
# -----------------------------------------------------------------------------
POSTGRES_USER=ai_sales
POSTGRES_PASSWORD=""
POSTGRES_DB=ai_sales_prod

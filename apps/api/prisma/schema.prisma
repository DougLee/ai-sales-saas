// ============================================
// 审计日志（V3.1 新增：操作审计 + 登录历史）
// ============================================

/// 全量操作审计：所有写操作自动记录（Prisma middleware 写入）
model AuditLog {
  id          String   @id @default(cuid())
  tenantId    String
  userId      String? // null = 系统操作或未登录
  userEmail   String? // 冗余存（删用户不丢审计）
  action      String // CREATE / UPDATE / DELETE / LOGIN / LOGOUT / EXPORT / CONFIGURE / UPLOAD / DOWNLOAD / AI_CALL
  entity      String? // Lead / Project / Visit / User / AiConfig ...
  entityId    String?
  description String? // 人类可读："创建客户：河南科技学院"
  changes     Json? // { before: {field: old}, after: {field: new} }，仅 UPDATE
  ip          String?
  userAgent   String?
  severity    String   @default("info") // info / warning / critical
  metadata    Json?
  createdAt   DateTime @default(now())

  @@index([tenantId, createdAt])
  @@index([tenantId, userId, createdAt])
  @@index([tenantId, action])
  @@index([tenantId, severity])
  @@index([entity, entityId])
}

/// 业务变更历史：记录客户/联系人/线索/商机关键字段变更
model ChangeHistory {
  id           String   @id @default(cuid())
  tenantId     String
  entityType   String // company / contact / lead / project
  entityId     String
  fieldName    String
  oldValue     String?
  newValue     String?
  changedBy    String // userId
  changeSource String   @default("manual") // manual / ai / import / merge
  createdAt    DateTime @default(now())
  tenant       Tenant   @relation(fields: [tenantId], references: [id])

  @@index([tenantId, entityType, entityId, createdAt])
}

/// 登录历史：所有登录尝试都记录（成功/失败都记）
model LoginHistory {
  id            String   @id @default(cuid())
  tenantId      String? // null = 登录失败（账号不存在）
  userId        String?
  email         String // 即使失败也记，便于检测爆破
  ip            String
  userAgent     String?
  status        String // success / wrong_password / user_not_found / disabled / kicked
  sessionId     String? // 成功后关联 session
  failureReason String?
  createdAt     DateTime @default(now())

  @@index([email, createdAt])
  @@index([ip, createdAt])
  @@index([tenantId, createdAt])
  @@index([status, createdAt])
}

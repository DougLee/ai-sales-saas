# =============================================================================
# AI 销售管理系统 — 本地开发环境变量模板
# 复制本文件为 .env 后按需修改
# =============================================================================

# -----------------------------------------------------------------------------
# 核心运行时（必填）
# -----------------------------------------------------------------------------

# 数据库：本地开发使用 PostgreSQL + pgvector
DATABASE_URL="postgresql://ai_sales:ai_sales_dev@localhost:5432/ai_sales_dev?schema=public"

# Redis：用于 session、限流计数器、agent 记忆
REDIS_URL="redis://localhost:6379"

# JWT 密钥：至少 32 位随机字符串，生产环境必须替换
JWT_SECRET="change-me-to-a-32-char-random-string!!"

# Node 环境
NODE_ENV="development"
PORT=3000

# -----------------------------------------------------------------------------
# 可观测性（可选，有默认值）
# -----------------------------------------------------------------------------
LOG_LEVEL="info"              # trace / debug / info / warn / error / fatal
SERVICE_NAME="ai-sales-api"
# SERVICE_VERSION=""          # 默认从 package.json 读取

# -----------------------------------------------------------------------------
# AI 大模型（可选，无 AI 功能可留空）
# -----------------------------------------------------------------------------
# 支持 OpenAI 官方或任意 OpenAI 兼容接口（DeepSeek / SiliconFlow / Moonshot 等）
OPENAI_API_KEY=""
OPENAI_BASE_URL=""           # 例如 https://api.siliconflow.cn/v1

# Embedding 可单独配置；默认复用上方凭证
# EMBEDDING_API_KEY=""
# EMBEDDING_BASE_URL=""
EMBEDDING_MODEL_NAME="BAAI/bge-m3"
EMBEDDING_DIMENSION=1024

# 语音转写（SenseVoice，可选）
# SENSEVOICE_API_KEY=""
# SENSEVOICE_BASE_URL=""

# -----------------------------------------------------------------------------
# 限流（可选，有默认值）
# -----------------------------------------------------------------------------
RATE_LIMIT_DEFAULT_MAX=200
RATE_LIMIT_DEFAULT_WINDOW_MS=60000
RATE_LIMIT_AGENT_MAX=20
RATE_LIMIT_AGENT_WINDOW_MS=60000

# -----------------------------------------------------------------------------
# 对象存储（可选，无文件上传可留空）
# -----------------------------------------------------------------------------
MINIO_ENDPOINT="http://localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"

# -----------------------------------------------------------------------------
# 搜索增强（可选）
# -----------------------------------------------------------------------------
# BING_SEARCH_API_KEY=""
# TAVILY_API_KEY=""

# -----------------------------------------------------------------------------
# Docker Compose 本地开发（可选）
# -----------------------------------------------------------------------------
POSTGRES_USER=ai_sales
POSTGRES_PASSWORD=ai_sales_dev
POSTGRES_DB=ai_sales_dev
